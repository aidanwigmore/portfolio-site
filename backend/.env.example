# Backend environment variables
# Copy this file to .env for local development (never commit the actual .env).
# In production, set these as Azure App Service Application Settings.

# ── Required ────────────────────────────────────────────────────────────────

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# ── Optional (defaults shown) ────────────────────────────────────────────────

# Set to True only in development.
DEBUG=False

# Comma-separated list of hostnames Django will serve.
# Example: ALLOWED_HOSTS=your-app.azurewebsites.net,www.example.com
ALLOWED_HOSTS=

# Comma-separated list of frontend origins allowed for CORS.
# Example: CORS_ALLOWED_ORIGINS=https://your-frontend.azurestaticapps.net
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection string (falls back to local SQLite when not set).
# Example: DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# ── Azure Blob Storage (leave blank to use local media/ directory) ────────────

# Azure Storage account name.
AZURE_ACCOUNT_NAME=

# Azure Storage account key (or leave blank and use AZURE_CONNECTION_STRING instead).
AZURE_ACCOUNT_KEY=

# Full Azure Storage connection string (alternative to account name + key).
AZURE_CONNECTION_STRING=

# Blob container name for uploaded media files.
AZURE_MEDIA_CONTAINER=media
