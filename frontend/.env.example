# Frontend environment variables
# Copy this file to .env.production (or set as GitHub Actions / Azure Static Web Apps secrets).
# REACT_APP_* variables are embedded into the build at compile time by Create React App.

# URL of the deployed Django backend API (must include trailing slash).
# Example: https://your-backend.azurewebsites.net/api/
REACT_APP_API_URL=https://your-backend.azurewebsites.net/api/
